{
  "name": "product-service",
  "version": "0.1.0",
  "description": "Product and category API service",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "migration:run": "yarn run build && node dist/database/run-migrations.js",
    "migration:revert": "yarn run build && node dist/database/revert-migration.js",
    "seed": "yarn run build && node dist/database/seed.js",
    "seed:categories": "yarn run build && node dist/database/seed-categories.js",
    "lint": "oxlint --type-aware src/",
    "test": "yarn run build && node --test"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/typeorm": "^11.0.0",
    "dotenv": "^16.4.7",
    "mysql2": "^3.14.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.25"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/node": "^24.0.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "typescript": "^6.0.2"
  },
  "resolutions": {
    "multer": "^2.5.0"
  }
}
